<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:letterSpacing="0.08"
        android:text="@string/app_name"
        android:textColor="@color/ink"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:layout_marginTop="6dp"
        android:text="@string/tagline"
        android:textColor="@color/ink_dim"
        android:textSize="15sp" />

    <Button
        android:id="@+id/host_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/accent"
        android:text="@string/host_game"
        android:textColor="@color/accent_ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/host_blurb"
        android:textColor="@color/ink_dim"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:text="@string/or_join"
        android:textAllCaps="true"
        android:textColor="@color/line"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.12"
        android:text="@string/host_label"
        android:textColor="@color/ink_dim"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/host_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:autofillHints=""
        android:background="@color/bg_sunken"
        android:hint="@string/host_hint"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:padding="16dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink_dim"
        android:textSize="19sp" />

    <Button
        android:id="@+id/connect_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/bg_raised"
        android:text="@string/connect"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/find_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/bg_raised"
        android:text="@string/find"
        android:textColor="@color/ink"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/warn"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/found_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />
  </LinearLayout>
</ScrollView>
